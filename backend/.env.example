# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL address: postgres://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgres://localhost:5432/moviedb?sslmode=disable

# Make a long random string, for example:  openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# Free key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

PORT=8000

# Frontend addresses allowed to call the API (comma separated). * = everyone.
CORS_ORIGINS=*
